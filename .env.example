# Path to opencode binary (optional, autodetected)
OPENCODE_BIN=opencode
# Browser channel to use for ChatGPT automation: chrome | chromium
JARVIS_BROWSER_CHANNEL=chrome
# Run browser headless (default: false, visible mode)
JARVIS_HEADLESS=false
# Root dir for runtime state (default: <repo>/runtime)
JARVIS_RUNTIME_DIR=
