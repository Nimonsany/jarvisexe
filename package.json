{
  "name": "jarvis-orchestrator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "jarvis": "npm run jarvis -w packages/core --",
    "test": "npm test -w packages/core",
    "test:m7": "npx tsx --test tests/e2e/m7-release-hardening.e2e.test.ts",
    "test:m8-core-endpoint": "npx tsx --test tests/m8-core-endpoint.test.ts",
    "test:m8-ownership": "npx tsx --test tests/m8-ownership.test.ts",
    "test:m8-voice": "npx tsx --test tests/m8-voice-mode.test.ts",
    "test:m8": "npx tsx --test tests/e2e/m8-gui-clean-install.e2e.test.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
